{
  "name": "raghav-portfolio",
  "account_id": "4e0410e0d8e8384fa1286d7c497054a7",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "raghavghimire.com.np", "custom_domain": true },
    { "pattern": "www.raghavghimire.com.np", "custom_domain": true }
  ]
}
