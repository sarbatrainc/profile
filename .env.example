# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
# Every variable is optional: when a value is missing the portfolio hides the
# related link instead of showing a broken or invented URL.
# ---------------------------------------------------------------------------

# Public site URL — used for SEO metadata, sitemap, robots.txt and Open Graph.
# No trailing slash. Example: https://raghavghimire.com
NEXT_PUBLIC_SITE_URL=

# Contact
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE=

# Links (full https URLs). Leave blank to hide the button/link.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_RESUME_URL=
NEXT_PUBLIC_X_URL=

# Optional: shared secret / API endpoint for a hosted contact form.
# If empty, the contact form falls back to a prefilled mailto: message.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=